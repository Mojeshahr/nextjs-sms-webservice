# کپی کنید به .env.local و مقادیر خودتان را بگذارید. فایل .env.local کامیت
# نمی‌شود.
#
# نام این متغیرها را با NEXT_PUBLIC_ شروع نکنید. هر متغیری که آن پیشوند را
# داشته باشد، Next.js مقدارش را داخل باندل مرورگر می‌نویسد و کلیدتان در
# View Source دیده می‌شود. این متغیرها فقط روی سرور خوانده می‌شوند و باید
# همین‌طور بمانند.

# کلید اختصاصی حساب، از پنل کاربری پیام رسان.
# شش رقم شناسه کاربری، خط تیره، و بخش کلید که دست‌کم پانزده نویسه است.
PAYAM_RESAN_API_KEY=123456-XXXXXXXXXXXXXXX

# یکی از خطوط فعال حساب. با روت /api/sms/account-info فهرستشان را ببینید.
PAYAM_RESAN_SENDER=30004040
